#Loading Data
GABA_cntrl <-c(0.228,0.234,0.22)
GABA_alcl <- c(0.231,0.238,0.226)
GABA_alcl_fla <-c(0.239,0.234,0.231)
GABA_alcl_fla_2 <-c(.236,.25,.221)
GABA_alcl_Don <-c(.146,.145,.11)
NO2_cntrl <-c(.21,.232,.235)
NO2_alcl <-c(.211,.234,.238)
NO2_alcl_fla <-c(.212,.24,.246)
NO2_alcl_fla_2 <-c(.212,.244,.252)
NO2_alcl_Don <-c(.215,.243,.255)
MDA_cntrl <- c(.005,.017,.022)
MDA_alcl <-c(.004,.023,.026)
MDA_alcl_fla <-c(.004,.029,.032)
MDA_alcl_fla_2 <-c(.005,.034,.038)
MDA_alcl_Don <- c(.008,.045,.038)
#Compiling data
GABA_anl <- data.frame(GABA_cntrl,GABA_alcl,GABA_alcl_fla,GABA_alcl_fla_2,GABA_alcl_Don)
NO2_anl <- data.frame(NO2_cntrl,NO2_alcl,NO2_alcl_fla,NO2_alcl_fla_2,NO2_alcl_Don)
MDA_anl <- data.frame(MDA_cntrl,MDA_alcl,MDA_alcl_fla,MDA_alcl_fla_2,MDA_alcl_Don)
GABA_means <-cbind(mean(GABA_cntrl),mean(GABA_alcl),mean(GABA_alcl_fla),
mean(GABA_alcl_fla_2),mean(GABA_alcl_Don))
MDA_means <-cbind(mean(MDA_cntrl),mean(MDA_alcl),mean(MDA_alcl_fla),
mean(MDA_alcl_fla_2),mean(MDA_alcl_Don))
NO2_means <-cbind(mean(NO2_cntrl),mean(NO2_alcl),mean(NO2_alcl_fla),
mean(NO2_alcl_fla_2),mean(NO2_alcl_Don))
#Summary of Biochemical analysis data
summary(GABA_anl)
summary(NO2_anl)
summary(MDA_anl)
